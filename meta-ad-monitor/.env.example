# 이 파일을 복사해 같은 폴더에 ".env" 로 저장하고, 아래 값을 채우세요.
# (.env 는 git 에 올라가지 않습니다 — 키 안전)

# ── 로컬 크롤에 필수 ──────────────────────────────
# Supabase 프로젝트 설정 > API 에서 복사
# Project URL
SUPABASE_URL=https://xxxx.supabase.co
# service_role 키 (secret). 절대 외부에 공유/커밋하지 마세요.
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# ── Apify 전량 수집(apify-import-*.bat)을 쓸 때 필수 ──
# Apify 콘솔 → Settings → Integrations(API & Integrations) → Personal API tokens 에서 복사
APIFY_TOKEN=apify_api_...
# (선택) actor 변경 시. 기본 = curious_coder/facebook-ads-library-scraper
# APIFY_ACTOR=XtaWFhbtfxyzqrFmd
# (선택) 브랜드당 최대 수집 개수(기본 1000)
# APIFY_COUNT=1000

# ── 선택(셀프 힐링 heal 기능을 쓸 때만) ───────────
# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=sk-ant-...
