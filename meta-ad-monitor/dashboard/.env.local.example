# Supabase (기존 프로젝트의 값). 대시보드 → Settings → API 에서 확인.
# service_role 키는 서버(API 라우트)에서만 쓰이고 브라우저에 노출되지 않습니다.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...service_role...

# AI 요약(🧠) 기능에 필요. https://console.anthropic.com 에서 발급.
ANTHROPIC_API_KEY=sk-ant-...

# Vercel 에 배포할 때는 위 값들을 Project Settings → Environment Variables 에 넣으세요.
