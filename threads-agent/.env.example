# 쓰레드 수집 워커 설정 — 이 파일을 .env 로 복사해서 채우세요.
# 수집만 담당(발행은 서버 크론). Supabase service_role 키가 필요 없습니다.

# 서버(제작 사이트) 주소
CC_SERVER_URL=https://da-ad-planner.vercel.app

# 수집 워커 인증 토큰 — Vercel 환경변수 TH_AGENT_TOKEN 과 "똑같은 값"으로 맞추세요.
# (서버에 TH_AGENT_TOKEN 을 설정하지 않으면 비워둬도 동작하지만, 보안상 설정 권장)
TH_AGENT_TOKEN=

# (선택) 수집 주기(분) — 기본 120
TH_COLLECT_INTERVAL_MIN=120

# (선택) 크롬 실행파일 경로 — 채널 자동탐색(chrome/msedge) 실패 시에만
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# (선택) 브라우저 프로필 폴더(로그인 세션 저장) — 기본 threads-agent\.playwright-threads
# TH_PROFILE_DIR=
