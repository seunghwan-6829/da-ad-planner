# ── 인스타 성과(Instagram Graph API) 연동에 필요한 환경변수 ──
# 실제 값은 절대 커밋하지 말 것. Vercel 프로젝트 환경변수 + GitHub Actions Secrets 에 넣으세요.

# Supabase (이미 운영 중인 값 그대로 사용)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Meta(Facebook) 앱 — developers.facebook.com 에서 Business 타입 앱 생성 후 확보
META_APP_ID=
META_APP_SECRET=

# Graph API 버전(1곳에서 중앙 관리). 분기마다 메타가 바꾸므로 최신 문서로 재확인.
GRAPH_VERSION=v22.0

# OAuth 리다이렉트 URI — 메타 앱에 동일하게 등록해야 함
# 예) https://da-ad-planner.vercel.app/api/auth/instagram/callback
OAUTH_REDIRECT_URI=

# 크론 엔드포인트 보호용 비밀(아무 긴 랜덤 문자열). GitHub Actions Secret 과 동일하게.
CRON_SECRET=

# 토큰 암호화 키(아무 긴 랜덤 문자열. 변경하면 기존 저장 토큰 복호화 불가 → 재연동 필요)
TOKEN_ENC_KEY=
